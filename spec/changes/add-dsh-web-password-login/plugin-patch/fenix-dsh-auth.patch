+function describeMissing(ctx) {
+	return REQUIRED_CONTRACTS
+		.filter(([serviceName, method]) => {
+			try {
+				return typeof ctx.get?.(serviceName)?.[method] !== 'function'
+			} catch {
+				return true
+			}
+		})
+		.map(([serviceName, method]) => `${serviceName}.${method}`)
+		.join(', ')
