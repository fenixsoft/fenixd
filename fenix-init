#!/usr/bin/env python3
"""
fenix-init — Fenix Loop Engineering Framework 项目初始化命令。

在目标目录生成使用 fenixd 所需的工程骨架：
  - .fenix/（项目配置 config.yaml + 状态文件 STATE.md / PROJECT_LOG.md + 运行时目录 + 指向框架的软链接）
  - spec/{changes,specs}/ 与 spec/archive/
  - .claude/agents/（软链接）与 .claude/worktrees/
  - 幂等确保 .gitignore 含 fenix 运行时目录规则（.fenix/* 等）
  - 初始化产物自举：白名单文件（.fenix/verify.yaml 等）自动 git add——仅 staged
    不 commit，提交时机留给用户（init-self-bootstrap）

用法:
    fenix-init [DIR] [--name NAME] [--type web|cli|library|api]
    fenix-init [--ensure-gitignore] [DIR]   # 仅幂等补 .gitignore，不做其他初始化
"""

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

# Windows 控制台编码兜底：SSH 会话/旧式控制台下 stdout 默认回落到本地 ANSI
# 代码页（cp1252/cp936），中文日志 print 直接 UnicodeEncodeError 崩溃。
# 保编码不换（终端显示不失真），仅把不可编码字符替换掉，保证功能不中断。
if sys.platform == "win32":
    for _stream in (sys.stdout, sys.stderr):
        try:
            _stream.reconfigure(errors="replace")
        except (AttributeError, ValueError):
            pass

# 框架根目录 = 本脚本所在目录（经 .resolve() 跟随软链接，以定位真实安装位置）
FENIXD_HOME = Path(__file__).resolve().parent

VALID_TYPES = ("web", "cli", "library", "api")

# 需要软链到项目 .fenix/ 的框架文件
# 注：launch-extension.cjs 已随框架移除，不再创建（存量项目里的悬空链接可手工清理）
FENIX_LINKS = ["core", "bin", "tests", "fenixd.py", "__init__.py"]

# 需要软链到项目 .claude/agents/ 的 agent 定义
AGENT_LINKS = ["implementer.md", "verifier.md"]

# 白名单文件（templates/gitignore-fenix.txt 的 `!` 规则放行者）：
# 放行即声明入库意图，init 完成骨架写入后自动 git add（仅 staged 不 commit）
WHITELIST_FILES = (".fenix/todo.md", ".fenix/verify.yaml")


def log(msg: str):
    print(msg)


def ensure_dir(path: Path):
    path.mkdir(parents=True, exist_ok=True)


def symlink(target: Path, link: Path):
    """创建软链接；若目标已存在则跳过，避免覆盖用户文件。"""
    if link.exists() or link.is_symlink():
        log(f"  ⏭  {link.name} 已存在，跳过")
        return
    os.symlink(str(target), str(link))
    log(f"  ✅ {link.name} -> {target}")


def render_config(project_name: str, project_type: str) -> str:
    template = FENIXD_HOME / ".fenix" / "config.template.yaml"
    if not template.exists():
        sys.exit(f"错误：找不到配置模板 {template}")
    content = template.read_text(encoding="utf-8")
    content = content.replace("{{PROJECT_NAME}}", project_name)
    content = content.replace("{{PROJECT_TYPE}}", project_type)
    return content


def _gitignore_rule_block(snippet: str, rule: str) -> str:
    """从模板 snippet 提取以规则行 rule（整行匹配）为锚的块：规则行 + 紧邻前导注释行。

    模板文件是追加文本的唯一来源（模板侧与 --ensure-gitignore 侧同一段实现
    产出，禁止两处文本漂移）：追加块从模板抽取而非在代码里维护第二份文本。
    模板被改坏（规则行缺席）时退化为裸规则行，不丢功能。
    """
    lines = snippet.splitlines()
    idx = next((i for i, ln in enumerate(lines) if ln.strip() == rule), None)
    if idx is None:
        return rule + "\n"
    start = idx
    while start > 0 and lines[start - 1].lstrip().startswith("#"):
        start -= 1
    return "\n".join(lines[start:idx + 1]) + "\n"


def append_gitignore(project_root: Path):
    """确保 .gitignore 含 fenix 运行时目录规则（幂等，可重复调用）。

    判据取关键规则行（``^\\.fenix/\\*`` 与 ``^\\.claude/agents/$``）而非整段
    标记：旧模板生成的项目（有标记但规则缺项）重跑时能逐规则补齐；规则已齐
    的项目跳过，不产生重复条目。``.claude/agents/`` 为框架播种运行时产物的
    预防性 ignore（init-self-bootstrap D2），缺失时按模板块幂等追加。
    """
    snippet_path = FENIXD_HOME / "templates" / "gitignore-fenix.txt"
    snippet = snippet_path.read_text(encoding="utf-8") if snippet_path.exists() else ""

    gitignore = project_root / ".gitignore"
    existing = gitignore.read_text(encoding="utf-8") if gitignore.exists() else ""

    new_content = existing
    appended = []

    if not re.search(r"(?m)^\.fenix/\*$", new_content):
        # fenix 主段（.fenix/* + 白名单放行规则）整体追加，保持既有整段产出
        if new_content:
            if not new_content.endswith("\n"):
                new_content += "\n"
            new_content = new_content + "\n" + snippet
        else:
            new_content = snippet
        appended.append("fenix 条目")

    if not re.search(r"(?m)^\.claude/agents/$", new_content):
        block = _gitignore_rule_block(snippet, ".claude/agents/")
        if new_content:
            if not new_content.endswith("\n"):
                new_content += "\n"
            new_content = new_content + "\n" + block
        else:
            new_content = block
        appended.append(".claude/agents/ 预防性 ignore 规则")

    if not appended:
        log("  ⏭  .gitignore 已含 fenix 运行时规则（.fenix/* 与 .claude/agents/），跳过")
        return

    gitignore.write_text(new_content, encoding="utf-8")
    for msg in appended:
        log(f"  ✅ 已追加 {msg}到 .gitignore")


def git_add_whitelist_files(project_root: Path):
    """初始化产物自举（init-self-bootstrap D1）：白名单文件自动 git add。

    只 add 白名单文件的离散路径，MUST NOT `git add .`——骨架生成时项目里可能
    已有用户未跟踪文件，批量 add 会替用户做出入库决定。逐文件存在性守卫：
    init 不播种 todo.md（由自省/进化车道后续创建），当期不存在时跳过该文件且
    不报错，其在场时一并入库。仅 staged 不 commit（提交时机留给用户）；
    unborn 分支（零提交史）git add 正常工作，无需特殊处理；幂等重跑不报错。
    """
    try:
        probe = subprocess.run(
            ["git", "rev-parse", "--is-inside-work-tree"],
            cwd=str(project_root), capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        log("  ⚠  git 不可用，白名单文件待 git init 后手工入库")
        return
    if probe.returncode != 0 or probe.stdout.strip() != "true":
        log("  ⛅ 检测到非 git 仓库，白名单文件待 git init 后手工入库")
        return

    staged = []
    for rel in WHITELIST_FILES:
        target = project_root / rel
        if not target.exists():
            continue  # 逐文件存在性守卫：缺席的白名单文件跳过，不因 pathspec 缺失报错
        add = subprocess.run(
            ["git", "add", "--", rel],
            cwd=str(project_root), capture_output=True, text=True, timeout=10,
        )
        if add.returncode == 0:
            staged.append(rel)
        else:
            log(f"  ⚠  git add {rel} 失败（文件被 ignore 规则覆盖？）：{(add.stderr or '').strip()}")
    if staged:
        log(f"  ✅ 白名单文件已 git add（staged，提交时机留给用户）: {', '.join(staged)}")
    else:
        log("  ⏭  白名单文件均不在场，跳过 git add")


def main():
    parser = argparse.ArgumentParser(description="初始化 fenixd 工程骨架")
    parser.add_argument("dir", nargs="?", default=".", help="目标项目目录（默认当前目录）")
    parser.add_argument("--name", default=None, help="项目名（默认取目录名）")
    parser.add_argument("--type", default="web", choices=VALID_TYPES, help="项目类型（默认 web）")
    parser.add_argument(
        "--ensure-gitignore",
        action="store_true",
        help="仅幂等确保 .gitignore 含 fenix 运行时规则，不做其他初始化"
             "（供 fenix-setup 对已初始化项目调用）",
    )
    args = parser.parse_args()

    project_root = Path(args.dir).expanduser().resolve()

    if args.ensure_gitignore:
        log("fenix-init — 确保 .gitignore（幂等）")
        log(f"  项目目录: {project_root}")
        append_gitignore(project_root)
        return

    project_name = args.name or project_root.name or "fenix-project"
    project_type = args.type

    log("fenix-init — 生成 Fenix 工程骨架")
    log(f"  项目目录: {project_root}")
    log(f"  项目名:   {project_name}")
    log(f"  项目类型: {project_type}")
    log(f"  框架目录: {FENIXD_HOME}")
    log("")

    ensure_dir(project_root)

    # 1. .fenix/ —— 项目配置 + 运行时目录 + 框架软链接
    fenix_dir = project_root / ".fenix"
    ensure_dir(fenix_dir)
    for sub in ("logs", "verify-progress", "screenshots"):
        ensure_dir(fenix_dir / sub)

    config_path = fenix_dir / "config.yaml"
    if config_path.exists():
        log("  ⏭  .fenix/config.yaml 已存在，跳过")
    else:
        config_path.write_text(render_config(project_name, project_type), encoding="utf-8")
        log("  ✅ .fenix/config.yaml")

    for name in FENIX_LINKS:
        symlink(FENIXD_HOME / name, fenix_dir / name)

    # 2. .fenix/ 状态文件（STATE.md / PROJECT_LOG.md 与运行时同目录）
    for fname in ("STATE.md", "PROJECT_LOG.md"):
        target = fenix_dir / fname
        if target.exists():
            log(f"  ⏭  .fenix/{fname} 已存在，跳过")
        else:
            template = FENIXD_HOME / "templates" / fname
            target.write_text(template.read_text(encoding="utf-8") if template.exists() else "", encoding="utf-8")
            log(f"  ✅ .fenix/{fname}")

    # 2b. .fenix/verify.yaml（验证契约模板；全部配置行注释 = 无契约，框架安全回退）
    verify_path = fenix_dir / "verify.yaml"
    if verify_path.exists():
        log("  ⏭  .fenix/verify.yaml 已存在，跳过")
    else:
        template = FENIXD_HOME / "core" / "verify_contract_template.yaml"
        if template.exists():
            verify_path.write_text(template.read_text(encoding="utf-8"), encoding="utf-8")
            log("  ✅ .fenix/verify.yaml（契约模板，按项目实际取消注释启用）")
        else:
            log("  ⚠  找不到契约模板 core/verify_contract_template.yaml，跳过（不影响框架运行）")

    # 3. spec 目录
    for sub in ("changes", "specs"):
        ensure_dir(project_root / "spec" / sub)
    ensure_dir(project_root / "spec" / "archive")
    log("  ✅ spec/{changes,specs}/ 与 spec/archive/")

    # 4. .claude/agents（软链接）+ .claude/worktrees
    agents_dir = project_root / ".claude" / "agents"
    ensure_dir(agents_dir)
    for name in AGENT_LINKS:
        symlink(FENIXD_HOME / "agents" / name, agents_dir / name)
    ensure_dir(project_root / ".claude" / "worktrees")

    # 5. .gitignore
    append_gitignore(project_root)

    # 6. 初始化产物自举（init-self-bootstrap D1）：白名单文件自动 git add
    git_add_whitelist_files(project_root)

    log("")
    log("工程骨架已生成。下一步：")
    log("  1. 进入项目目录并启动框架: /fenix-setup")
    log("  2. 创建第一个需求: /fenix-new \"你的想法\"")
    log("  3. 查看状态: /fenix-status")


if __name__ == "__main__":
    main()
