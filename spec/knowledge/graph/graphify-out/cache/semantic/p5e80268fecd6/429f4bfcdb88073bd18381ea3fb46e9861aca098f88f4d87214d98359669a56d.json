{"nodes": [{"id": "adr_adr_002_model_routing_env_plus_official_model", "label": "ADR-002: Model Routing \u2014 env carries real route, --model uses official SDK name", "file_type": "document", "source_file": "adr/ADR-002-model-routing-env-plus-official-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "claude-code SDK subagent derivation rejects non-official model names with unrecognized_model; passing the real provider model name to --model breaks the subagent path while --model alone cannot carry provider baseurl/apikey, so a single routing mechanism valid for all agent lanes is needed."}, {"id": "adr_adr_002_model_routing_env_plus_official_model_env_route", "label": "Env-carried real route (ANTHROPIC_BASE_URL / ANTHROPIC_API_KEY / ANTHROPIC_MODEL)", "file_type": "concept", "source_file": "adr/ADR-002-model-routing-env-plus-official-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Real provider routing info is injected into process env for configured agent roles; --model never carries the real route, only the SDK validation name, and the provider gateway makes the final model selection based on env/requests."}, {"id": "adr_adr_002_model_routing_env_plus_official_model_sdk_model", "label": "sdk_model validation shim", "file_type": "concept", "source_file": "adr/ADR-002-model-routing-env-plus-official-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "sdk_model is both the SDK validation name and a model-name field visible to the provider gateway, so it may become the actually effective model; configuring it requires acknowledging the split between validation name and routing name."}, {"id": "adr_adr_002_model_routing_env_plus_official_model_subagent_model", "label": "agents.subagent_model fallback", "file_type": "concept", "source_file": "adr/ADR-002-model-routing-env-plus-official-model.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When a provider has no sdk_model, --model falls back to agents.subagent_model; roles without provider assignment get zero injection and behave exactly like the no-provider configuration."}], "edges": [{"source": "adr_adr_002_model_routing_env_plus_official_model", "target": "adr_adr_003_agent_lane_claude_config_dir_isolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adr/ADR-002-model-routing-env-plus-official-model.md", "source_location": null, "weight": 1.0}, {"source": "adr_adr_002_model_routing_env_plus_official_model", "target": "adr_adr_002_model_routing_env_plus_official_model_env_route", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adr/ADR-002-model-routing-env-plus-official-model.md", "source_location": null, "weight": 1.0}, {"source": "adr_adr_002_model_routing_env_plus_official_model", "target": "adr_adr_002_model_routing_env_plus_official_model_sdk_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adr/ADR-002-model-routing-env-plus-official-model.md", "source_location": null, "weight": 1.0}, {"source": "adr_adr_002_model_routing_env_plus_official_model", "target": "adr_adr_002_model_routing_env_plus_official_model_subagent_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adr/ADR-002-model-routing-env-plus-official-model.md", "source_location": null, "weight": 1.0}, {"source": "adr_adr_002_model_routing_env_plus_official_model_sdk_model", "target": "adr_adr_002_model_routing_env_plus_official_model_subagent_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adr/ADR-002-model-routing-env-plus-official-model.md", "sourc