+import test from 'node:test'
+import assert from 'node:assert/strict'
+import { EventEmitter } from 'node:events'
+import {
+	hashPassword,
+	verifyPassword,
+	createRateLimiter,
+	rateLimitHit,
+	renderLoginPage,
+	renderUntrustedHostPage,
+	probeUntrusted,
+	readTrustedHosts,
