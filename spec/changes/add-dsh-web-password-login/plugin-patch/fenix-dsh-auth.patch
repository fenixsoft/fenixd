+/** apply 阶段探测的六项上游契约（design「上游契约失配降级」探测清单）。 */
+const REQUIRED_CONTRACTS = [
+	['connection', 'authorizeIndex'],
+	['connection', 'authenticatedUrl'],
+	['connection', 'admit'],
+	['webServer', 'register'],
+	['webServer', 'readResource'],
+	['credentials', 'modifyRecord'],
