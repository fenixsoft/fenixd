+		salt: salt.toString('hex'),
+		hash: hash.toString('hex'),
+		N: SCRYPT_PARAMS.N,
+		r: SCRYPT_PARAMS.r,
+		p: SCRYPT_PARAMS.p,
+		keylen: SCRYPT_PARAMS.keylen,
+	}
