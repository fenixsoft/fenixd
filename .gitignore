# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/

# 虚拟环境
venv/
.venv/

# 系统文件
.DS_Store
Thumbs.db

# 本地历史（VS Code）/测试截图与临时文件统一存放
.history/

# ── Fenix Loop Engineering Framework ──

# Worktrees (managed by fenixd)
.claude/worktrees/

# 运行时/敏感目录（.fenix/config.yaml 含 API Key，绝不提交）
# 用 /* 而非 .fenix/：目录整体排除后无法用 ! 放行其下入库文件
.fenix/*
.claude/scheduled_tasks.json
.claude/scheduled_tasks.lock
.playwright-cli/
dist/

# 例外：状态文件随仓库入库（todo.md 自省条目 / verify.yaml 验证契约 / config 模板）
!.fenix/todo.md
!.fenix/verify.yaml
!.fenix/config.template.yaml

# v3 dashboard 构建产物不入库（2026-09-04 决策）：任何环境的交付件从本环境
# src 构建——merge 后框架自动重建主树产物供常驻 dashboard 服务；发布 tarball
# 内置预构建 dist（GitHub workflow）；源码使用者自行 npm install && npm run
# build。入库曾被证明是事故源：merge 产物冲突打回旧 bundle → 验证全量空转
# （help-center 洗白事故）

# 自动生成的运行时状态（STATE.md / PROJECT_LOG.md / .STATE.md.lock 均已迁入 .fenix/，
# 被 .fenix/* 覆盖；裸 .fenix-run-result.json 条目继续兜住归档 spec 目录里的结果快照）
.fenix-run-result.json
.coverage

# 验证契约 worktree 服务范围的临时 serving worktree（verify-contract 自管理）
verify-serving/

# daemon 运行时产物（锁文件/日志，本仓库自托管时生成于根目录）
daemon.lock
fenixd.log

# gh CLI 本机设备标识等本地运行时状态
.local/
todo.txt
