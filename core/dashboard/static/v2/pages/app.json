{
  "type": "app",
  "brandName": "Fenix",
  "header": {
    "type": "sse-bridge"
  },
  "asideBefore": [
    {
      "type": "service",
      "id": "broadcast-probe",
      "_note": "Task 5 移除:壳级临时探针,验证 SSE 桥广播链路(overview 页因 app 路由 404 预存问题无法渲染页级探针)",
      "onEvent": {
        "sse:refresh": {
          "actions": [
            { "actionType": "custom", "script": "window.Bridge._broadcastProbe = window.Bridge._broadcastProbe || {}; window.Bridge._broadcastProbe.received = true;" }
          ]
        }
      }
    }
  ],
  "pages": [
    { "label": "概览", "icon": "fa fa-home", "url": "/", "redirect": "/overview" },
    { "label": "导航", "children": [
      { "label": "概览", "icon": "fa fa-home", "url": "/overview", "schema": { "type": "page", "body": [] } },
      { "label": "项目", "url": "/project/:name", "schema": { "type": "page", "body": [] } },
      { "label": "SPEC 详情", "url": "/spec/:project/:name", "schema": { "type": "page", "body": [] } },
      { "label": "配置", "url": "/config", "schema": { "type": "page", "body": [] } },
      { "label": "配置", "url": "/config/:project", "schema": { "type": "page", "body": [] } },
      { "label": "运维记录", "url": "/activities", "schema": { "type": "page", "body": [] } },
      { "label": "运维记录", "url": "/activities/:project", "schema": { "type": "page", "body": [] } }
    ] }
  ]
}
