{
  "cases": {
    "implementer_lane": {
      "argv": [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--add-dir",
        "{WORKTREE}",
        "--permission-mode",
        "bypassPermissions",
        "--settings",
        "{PROJECT_ROOT}/.fenix/agent-settings.json"
      ],
      "bufsize": 1,
      "popen": {
        "cwd": "{WORKTREE}",
        "encoding": "utf-8",
        "errors": "replace",
        "start_new_session": true,
        "text": true
      },
      "stdin": "implement the thing"
    },
