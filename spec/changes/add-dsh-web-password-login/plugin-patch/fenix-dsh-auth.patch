+/** 服务就绪兜底轮询：间隔与总窗（dsh 插件装载早于服务激活时的保险）。 */
+const SERVICE_WAIT_INTERVAL_MS = 200
+const SERVICE_WAIT_MAX_ATTEMPTS = 50
