{
  "type": "page",
  "body": [
    {
      "type": "service",
      "id": "config-loader",
      "name": "config-loader",
      "api": {
        "url": "/api/config",
        "adaptor": "window.__configSnapshot = payload; window.__configDefaults = { agents: { max_concurrent: 2, max_turns: 300, run_timeout_seconds: 3600, daily_run_limit: 50, token_budget_millions: 50, impl_run_budget: 4 } }; return { status: 0, data: window.Adapters.adaptConfig(payload) };",
        "requestAdaptor": "var __pj = (window.V2 && window.V2.scope && window.V2.scope.project()) || ''; if (__pj) { api.url += '?project=' + encodeURIComponent(__pj); } return api;"
      },
      "body": [
        {
          "type": "form",
          "id": "config-form",
          "name": "config-form",
          "title": "",
          "api": {
            "method": "post",
            "url": "/api/config",
            "requestAdaptor": "var __pj = (window.V2 && window.V2.scope && window.V2.scope.project()) || ''; if (__pj) { api.url += '?project=' + encodeURIComponent(__pj); } var __r = window.V2 && window.V2.route && window.V2.route(); var __pj = __r && __r.params && __r.params[0]; if (__pj) { api.url = '/api/config?project=' + encodeURIComponent(__pj); } var out = window.Adapters.buildConfigPayload(api.data, window.__configSnapshot, window.__configDefaults); window.__lastConfigOut = out; window.__lastFormData = api.data; api.data = out; return api;",
            "adaptor": "var out = window.__lastConfigOut || {}; var fd = window.__lastFormData || {}; var agents = Object.assign({}, fd.agents || {}, out.agents || {}); var data = Object.assign({}, fd, { agents: agents, gates: out.gates || fd.gates }); window.__configSnapshot = Object.assign({}, window.__configSnapshot, { agents: out.agents, gates: out.gates }); return { status: 0, data: data };"
          },
          "body": [
            {
              "type": "tabs",
              "tabsMode": "line",
              "unmountOnExit": true,
              "tabs": [
                {
                  "title": "LLM Provider",
                  "body": [
                    {
                      "type": "tpl",
                      "tpl": "<div class='v2-config-hint'>定义可用的 LLM 提供者(baseurl / apikey / 默认模型)。</div>"
                    },
                    {
                      "type": "combo",
                      "name": "llm.providers",
                      "label": "LLM Provider 列表",
                      "multiple": true,
                      "addable": true,
                      "removable": true,
                      "strictMode": false,
                      "addButtonLabel": "+ 新增 Provider",
                      "items": [
                        {
                          "type": "input-text",
                          "name": "name",
                          "label": "名称",
                          "required": true,
                          "placeholder": "名称"
                        },
                        {
                          "type": "input-text",
                          "name": "baseurl",
                          "label": "Base URL",
                          "placeholder": "Base URL"
                        },
                        {
                          "type": "input-password",
                          "name": "apikey",
                          "label": "API Key"
                        },
                        {
                          "type": "input-text",
                          "name": "model",
                          "label": "默认模型",
                          "placeholder": "该 provider 的默认模型名"
                        }
                      ]
                    }
                  ]
                },
                {
                  "title": "Agent 模型分配",
                  "body": [
                    {
                      "type": "tpl",
                      "tpl": "<div class='v2-config-hint'>为每种 Agent 角色分配 Provider 与模型。链上模型名留空时使用角色级默认,角色级默认也留空时使用所选 Provider 的默认模型。</div>"
                    },
                    {
                      "type": "fieldSet",
                      "title": "Implementer(执行)",
                      "collapsable": true,
                      "collapsed": false,
                      "className": "v2-role-fieldset",
                      "body": [
                        {
                          "type": "input-text",
                          "name": "agents.models.implementer.model",
                          "label": "角色级默认模型",
                          "placeholder": "模型名(如 deepseek-v4-flash),可选",
                          "description": "留空表示无全链缺省,链上逐元素必须自带 model。"
                        },
                        {
                          "type": "combo",
                          "name": "agents.models.implementer.provider",
                          "label": "Provider 链(按优先级排序,failover 依次回退)",
                          "multiple": true,
                          "addable": true,
                          "removable": true,
                          "draggable": true,
                          "draggableTip": "可拖拽调整回退顺序",
                          "addButtonLabel": "+ 添加 Provider 行",
                          "strictMode": false,
                          "items": [
                            {
                              "type": "select",
                              "name": "provider",
                              "label": "Provider",
                              "source": "${llm.providers}",
                              "labelField": "name",
                              "valueField": "name",
                              "placeholder": "-- 选择 Provider --"
                            },
                            {
                              "type": "input-text",
                              "name": "model",
                              "label": "模型",
                              "placeholder": "留空用角色级缺省"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "fieldSet",
                      "title": "Planner Plan(生成场景)",
                      "collapsable": true,
                      "collapsed": true,
                      "className": "v2-role-fieldset",
                      "body": [
                        {
                          "type": "input-text",
                          "name": "agents.models.planner-plan.model",
                          "label": "角色级默认模型",
                          "placeholder": "模型名(如 deepseek-v4-flash),可选",
                          "description": "留空表示无全链缺省,链上逐元素必须自带 model。"
                        },
                        {
                          "type": "combo",
                          "name": "agents.models.planner-plan.provider",
                          "label": "Provider 链(按优先级排序,failover 依次回退)",
                          "multiple": true,
                          "addable": true,
                          "removable": true,
                          "draggable": true,
                          "draggableTip": "可拖拽调整回退顺序",
                          "addButtonLabel": "+ 添加 Provider 行",
                          "strictMode": false,
                          "items": [
                            {
                              "type": "select",
                              "name": "provider",
                              "label": "Provider",
                              "source": "${llm.providers}",
                              "labelField": "name",
                              "valueField": "name",
                              "placeholder": "-- 选择 Provider --"
                            },
                            {
                              "type": "input-text",
                              "name": "model",
                              "label": "模型",
                              "placeholder": "留空用角色级缺省"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "fieldSet",
                      "title": "Planner Judge(判定结果)",
                      "collapsable": true,
                      "collapsed": true,
                      "className": "v2-role-fieldset",
                      "body": [
                        {
                          "type": "input-text",
                          "name": "agents.models.planner-judge.model",
                          "label": "角色级默认模型",
                          "placeholder": "模型名(如 deepseek-v4-flash),可选",
                          "description": "留空表示无全链缺省,链上逐元素必须自带 model。"
                        },
                        {
                          "type": "combo",
                          "name": "agents.models.planner-judge.provider",
                          "label": "Provider 链(按优先级排序,failover 依次回退)",
                          "multiple": true,
                          "addable": true,
                          "removable": true,
                          "draggable": true,
                          "draggableTip": "可拖拽调整回退顺序",
                          "addButtonLabel": "+ 添加 Provider 行",
                          "strictMode": false,
                          "items": [
                            {
                              "type": "select",
                              "name": "provider",
                              "label": "Provider",
                              "source": "${llm.providers}",
                              "labelField": "name",
                              "valueField": "name",
                              "placeholder": "-- 选择 Provider --"
                            },
                            {
                              "type": "input-text",
                              "name": "model",
                              "label": "模型",
                              "placeholder": "留空用角色级缺省"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "fieldSet",
                      "title": "Verifier(旧版验证)",
                      "collapsable": true,
                      "collapsed": true,
                      "className": "v2-role-fieldset",
                      "body": [
                        {
                          "type": "input-text",
                          "name": "agents.models.verifier.model",
                          "label": "角色级默认模型",
                          "placeholder": "模型名(如 deepseek-v4-flash),可选",
                          "description": "留空表示无全链缺省,链上逐元素必须自带 model。"
                        },
                        {
                          "type": "combo",
                          "name": "agents.models.verifier.provider",
                          "label": "Provider 链(按优先级排序,failover 依次回退)",
                          "multiple": true,
                          "addable": true,
                          "removable": true,
                          "draggable": true,
                          "draggableTip": "可拖拽调整回退顺序",
                          "addButtonLabel": "+ 添加 Provider 行",
                          "strictMode": false,
                          "items": [
                            {
                              "type": "select",
                              "name": "provider",
                              "label": "Provider",
                              "source": "${llm.providers}",
                              "labelField": "name",
                              "valueField": "name",
                              "placeholder": "-- 选择 Provider --"
                            },
                            {
                              "type": "input-text",
                              "name": "model",
                              "label": "模型",
                              "placeholder": "留空用角色级缺省"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "type": "fieldSet",
                      "title": "Administrator(运维)",
                      "collapsable": true,
                      "collapsed": true,
                      "className": "v2-role-fieldset",
                      "body": [
                        {
                          "type": "input-text",
                          "name": "agents.models.administrator.model",
                          "label": "角色级默认模型",
                          "placeholder": "模型名(如 deepseek-v4-flash),可选",
                          "description": "留空表示无全链缺省,链上逐元素必须自带 model。"
                        },
                        {
                          "type": "combo",
                          "name": "agents.models.administrator.provider",
                          "label": "Provider 链(按优先级排序,failover 依次回退)",
                          "multiple": true,
                          "addable": true,
                          "removable": true,
                          "draggable": true,
                          "draggableTip": "可拖拽调整回退顺序",
                          "addButtonLabel": "+ 添加 Provider 行",
                          "strictMode": false,
                          "items": [
                            {
                              "type": "select",
                              "name": "provider",
                              "label": "Provider",
                              "source": "${llm.providers}",
                              "labelField": "name",
                              "valueField": "name",
                              "placeholder": "-- 选择 Provider --"
                            },
                            {
                              "type": "input-text",
                              "name": "model",
                              "label": "模型",
                              "placeholder": "留空用角色级缺省"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "title": "并行度设置",
                  "body": [
                    {
                      "type": "tpl",
                      "tpl": "<div class='v2-config-hint'>同时运行的 Agent 进程数上限。调度采用<b>严格优先级并行</b>:高优先级任务先执行;同一优先级内可并行至该上限;不同优先级不并行(低优先级等高优先级全部完成后才启动)。</div>"
                    },
                    {
                      "type": "input-number",
                      "name": "agents.max_concurrent",
                      "label": "并行度(agents.max_concurrent)",
                      "min": 1,
                      "value": 2,
                      "description": "默认 2。保存后约 30 秒内热加载生效。"
                    },
                    {
                      "type": "input-number",
                      "name": "agents.max_turns",
                      "label": "单次 Agent 运行轮次上限(agents.max_turns)",
                      "min": 1,
                      "value": 300,
                      "description": "默认 300(上限而非目标值)。单个 Agent 运行轮次达到此值即被终止并触发重试。"
                    },
                    {
                      "type": "input-number",
                      "name": "agents.run_timeout_seconds",
                      "label": "单次运行时长上限(agents.run_timeout_seconds,秒)",
                      "min": 60,
                      "step": 60,
                      "value": 3600,
                      "description": "默认 3600(1 小时)。单个 Agent 运行超时即终止并触发重试。"
                    },
                    {
                      "type": "input-number",
                      "name": "agents.daily_run_limit",
                      "label": "每日 Agent 运行限额(agents.daily_run_limit,0 = 不限)",
                      "min": 0,
                      "value": 50,
                      "description": "默认 50。单个 UTC 自然日内所有 Agent 类型成功运行的累计上限(实现/验证/管理共用一个池),达到后当日停止派发,UTC 次日 0 点自动归零。设为 0 表示不限制。"
                    },
                    {
                      "type": "input-number",
                      "name": "agents.impl_run_budget",
                      "label": "实现尝试预算(agents.impl_run_budget,1-10)",
                      "min": 1,
                      "max": 10,
                      "step": 1,
                      "value": 4,
                      "description": "默认 4。每 SPEC 跨修复周期的实现 run 启动次数上限(含首次实现与每轮修复重派)。达到上限即冻结该 SPEC 并交人工裁决,需人工调大预算或推进状态。合法范围 1-10。"
                    }
                  ]
                },
                {
                  "title": "审批模式",
                  "body": [
                    {
                      "type": "tpl",
                      "tpl": "<div class='v2-config-hint'>SPEC 到达 done 后的行为。<b>auto 模式将自动执行 git push 到远端</b>,请谨慎使用。</div>"
                    },
                    {
                      "type": "radios",
                      "name": "gates.approve_mode",
                      "label": "审批模式",
                      "value": "manual",
                      "mode": "inline",
                      "options": [
                        {
                          "label": "manual — 人工审批(默认):SPEC 完成后停留在 done,等待 /fenix-approve 人工推送。",
                          "value": "manual"
                        },
                        {
                          "label": "auto — 自动推送:⚠ SPEC 完成后 daemon 自动执行 git push origin fenix/<spec>。",
                          "value": "auto"
                        }
                      ]
                    }
                  ]
                },
                {
                  "title": "界面风格",
                  "body": [
                    {
                      "type": "radios",
                      "label": "界面主题",
                      "name": "__theme",
                      "value": "${theme}",
                      "mode": "inline",
                      "options": [
                        {
                          "label": "深色（默认）",
                          "value": "dark"
                        },
                        {
                          "label": "浅色",
                          "value": "light"
                        }
                      ],
                      "description": "切换后立即整页生效并持久化到浏览器（fenix.theme）。",
                      "onEvent": {
                        "change": {
                          "actions": [
                            {
                              "actionType": "custom",
                              "script": "localStorage.setItem('fenix.theme', event.data.value || 'dark'); window.location.reload();"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "tpl",
                      "tpl": "<div class='v2-muted'>主题偏好保存在浏览器 localStorage（fenix.theme），不进入保存路径。</div>"
                    }
                  ]
                }
              ]
            },
            {
              "type": "submit",
              "label": "保存配置"
            }
          ],
          "onEvent": {
            "submitSucc": {
              "actions": [
                {
                  "actionType": "toast",
                  "args": {
                    "msgType": "success",
                    "msg": "保存成功"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}