{"nodes": [{"id": "adr_adr_001_agent_run_jsonl_protocol", "label": "ADR-001 Agent Run JSONL Protocol", "file_type": "document", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Long-running agents under blocking capture mode produce no on-disk output during the run and only a final 500-char summary enters the log, making progress unobservable; reading Claude Code session transcripts depends on internal layout and is fragile across project paths."}, {"id": "adr_adr_001_agent_run_jsonl_protocol_claude_subprocess", "label": "Claude Subprocess (claude -p)", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adr_adr_001_agent_run_jsonl_protocol_stream_json_output", "label": "stream-json Output Format", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adr_adr_001_agent_run_jsonl_protocol_fenix_runs_jsonl", "label": ".fenix/runs/<run_id>.jsonl Artifact", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen as the single process-data source for observability, forensics, progress parsing, and orphan/interrupt detection instead of reading Claude Code session transcripts, which are layout-dependent and fragile across project paths."}, {"id": "adr_adr_001_agent_run_jsonl_protocol_run_id", "label": "run_id with Attempt Suffix", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "run_id embeds the attempt ordinal (<prefix>-<spec>-<unix_ts>-a<n>); timestamp parsing is centralized in the read side (get_runs) and the generator format is intentionally not changed to keep that responsibility in one place."}, {"id": "adr_adr_001_agent_run_jsonl_protocol_get_runs", "label": "get_runs Reader", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Centralizes time-stamp and run metadata parsing duties so parsing logic does not leak into run_id generation."}, {"id": "adr_adr_001_agent_run_jsonl_protocol_implementer", "label": "Implementer Agent Role", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adr_adr_001_agent_run_jsonl_protocol_verifier", "label": "Verifier Agent Role", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adr_adr_001_agent_run_jsonl_protocol_planner", "label": "Planner Agent Role", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adr_adr_001_agent_run_jsonl_protocol_administrator", "label": "Administrator Agent Role", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adr_adr_001_agent_run_jsonl_protocol_provider_marker", "label": "provider_marker Line", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional line written at attempt start to record the provider/model of that attempt."}, {"id": "adr_adr_001_agent_run_jsonl_protocol_result_event", "label": "result Event", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The final return value is reconstructed from the last result event in the file so caller-visible semantics stay equivalent to non-streaming mode."}, {"id": "adr_adr_001_agent_run_jsonl_protocol_stderr_line", "label": "stderr Fallback Line", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-JSON lines are wrapped as {\"type\":\"stderr\",\"line\":...} so the file is always parseable line-by-line at any moment."}, {"id": "adr_adr_001_agent_run_jsonl_protocol_error_event", "label": "error Terminal Event", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appended on exception/timeout to give the file a definite terminal state."}, {"id": "adr_adr_001_agent_run_jsonl_protocol_interrupted_event", "label": "interrupted Terminal Event", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Appended on graceful daemon shutdown so the run file records an explicit interrupted terminal state."}, {"id": "adr_adr_001_agent_run_jsonl_protocol_dashboard", "label": "Dashboard", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null}, {"id": "adr_adr_001_agent_run_jsonl_protocol_run_retention", "label": ".fenix/runs Retention Policy", "file_type": "concept", "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only the most recent N run artifacts are kept (default 20), cleaned at startup/poll, keeping the artifact directory bounded; read-side capabilities that depend on a run file break after cleanup, so persisted capabilities must not rely solely on run files."}], "edges": [{"source": "adr_adr_001_agent_run_jsonl_protocol_implementer", "target": "adr_adr_001_agent_run_jsonl_protocol_claude_subprocess", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "weight": 1.0}, {"source": "adr_adr_001_agent_run_jsonl_protocol_verifier", "target": "adr_adr_001_agent_run_jsonl_protocol_claude_subprocess", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "weight": 1.0}, {"source": "adr_adr_001_agent_run_jsonl_protocol_planner", "target": "adr_adr_001_agent_run_jsonl_protocol_claude_subprocess", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "weight": 1.0}, {"source": "adr_adr_001_agent_run_jsonl_protocol_administrator", "target": "adr_adr_001_agent_run_jsonl_protocol_claude_subprocess", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adr/ADR-001-agent-run-jsonl-protocol.md", "source_location": null, "weight": 1.0}, {"source": "adr_adr_001_agent_run_jsonl_protocol_claude_sub