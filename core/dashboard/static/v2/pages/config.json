{
  "type": "page",
  "body": [
    {
      "type": "service",
      "id": "config-loader",
      "name": "config-loader",
      "api": {
        "url": "/api/config",
        "adaptor": "window.__configSnapshot = payload; window.__configDefaults = { agents: { max_concurrent: 2, max_turns: 300, run_timeout_seconds: 3600, daily_run_limit: 50, token_budget_millions: 50, impl_run_budget: 4 } }; return { status: 0, data: window.Adapters.adaptConfig(payload) };",
        "requestAdaptor": "var __pj = (window.V2 && window.V2.scope && window.V2.scope.project()) || ''; if (__pj) { api.url += '?project=' + encodeURIComponent(__pj); } return api;"
      },
      "body": [
        {
          "type": "form",
          "id": "config-form",
          "name": "config-form",
          "title": "",
          "api": {
            "method": "post",
            "url": "/api/config",
            "requestAdaptor": "var __pj = (window.V2 && window.V2.scope && window.V2.scope.project()) || ''; if (__pj) { api.url += '?project=' + encodeURIComponent(__pj); } var __r = window.V2 && window.V2.route && window.V2.route(); var __pj = __r && __r.params && __r.params[0]; if (__pj) { api.url = '/api/config?project=' + encodeURIComponent(__pj); } var out = window.Adapters.buildConfigPayload(api.data, window.__configSnapshot, window.__configDefaults); var chain = api.data && api.data.agents && api.data.agents.agent_chain; if (chain && chain.length > 0) { var provs = out.llm && out.llm.providers || []; var v = window.Adapters.validateChain(chain, provs); if (v !== true) { throw new Error(v); } } window.__lastConfigOut = out; window.__lastFormData = api.data; api.data = out; return api;",
            "adaptor": "var out = window.__lastConfigOut || {}; var fd = window.__lastFormData || {}; var agents = Object.assign({}, fd.agents || {}, out.agents || {}); var data = Object.assign({}, fd, { agents: agents, gates: out.gates || fd.gates }); window.__configSnapshot = Object.assign({}, window.__configSnapshot, { agents: out.agents, gates: out.gates }); return { status: 0, data: data };"
          },
          "body": [
            {
              "type": "tabs",
              "tabsMode": "line",
              "unmountOnExit": true,
              "tabs": [
                {
                  "title": "LLM Provider",
                  "body": [
                    {
                      "type": "combo",
                      "name": "llm.providers",
                      "label": "LLM Provider 列表",
                      "multiple": true,
                      "addable": true,
                      "removable": true,
                      "strictMode": false,
                      "items": [
                        {
                          "type": "input-text",
                          "name": "name",
                          "label": "名称",
                          "required": true,
                          "placeholder": "名称"
                        },
                        {
                          "type": "input-text",
                          "name": "baseurl",
                          "label": "Base URL",
                          "placeholder": "Base URL"
                        },
                        {
                          "type": "input-password",
                          "name": "apikey",
                          "label": "API Key"
                        },
                        {
                          "type": "input-text",
                          "name": "model",
                          "label": "默认模型",
                          "placeholder": "该 provider 的默认模型名"
                        }
                      ]
                    }
                  ]
                },
                {
                  "title": "Agent 模型分配",
                  "body": [
                    {
                      "type": "combo",
                      "name": "agents.agent_chain",
                      "label": "Agent 链(可排序)",
                      "multiple": true,
                      "addable": true,
                      "removable": true,
                      "draggable": true,
                      "strictMode": false,
                      "addButtonLabel": "新增",
                      "items": [
                        {
                          "type": "group",
                          "mode": "inline",
                          "gap": "sm",
                          "body": [
                            {
                              "type": "select",
                              "name": "role",
                              "label": "角色",
                              "options": [
                                {
                                  "label": "执行(Implementer)",
                                  "value": "implementer"
                                },
                                {
                                  "label": "生成场景(Planner Plan)",
                                  "value": "planner-plan"
                                },
                                {
                                  "label": "判定结果(Planner Judge)",
                                  "value": "planner-judge"
                                },
                                {
                                  "label": "验证(Verifier)",
                                  "value": "verifier"
                                },
                                {
                                  "label": "运维(Administrator)",
                                  "value": "administrator"
                                }
                              ]
                            },
                            {
                              "type": "input-text",
                              "name": "model",
                              "label": "模型",
                              "placeholder": "留空用 provider 默认"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "title": "并行度设置",
                  "body": [
                    {
                      "type": "input-number",
                      "name": "agents.max_concurrent",
                      "label": "并行度(max_concurrent)",
                      "min": 1,
                      "value": 2
                    },
                    {
                      "type": "input-number",
                      "name": "agents.max_turns",
                      "label": "单次运行轮次上限(max_turns)",
                      "min": 1,
                      "value": 300
                    },
                    {
                      "type": "input-number",
                      "name": "agents.run_timeout_seconds",
                      "label": "单次运行时长上限(秒)",
                      "min": 60,
                      "step": 60,
                      "value": 3600
                    },
                    {
                      "type": "input-number",
                      "name": "agents.daily_run_limit",
                      "label": "每日运行限额(0=不限)",
                      "min": 0,
                      "value": 50
                    },
                    {
                      "type": "input-number",
                      "name": "agents.token_budget_millions",
                      "label": "Token 预算（百万，0=关闭）",
                      "min": 0,
                      "max": 1000,
                      "step": 1,
                      "value": 50,
                      "desc": "单 spec 累计 input token 百万上限；达到 80% 提醒、100% 升级告警。0=关闭。"
                    },
                    {
                      "type": "input-number",
                      "name": "agents.impl_run_budget",
                      "label": "实现尝试预算（impl_run_budget）",
                      "min": 1,
                      "max": 10,
                      "step": 1,
                      "value": 4,
                      "desc": "单 spec 跨修复轮累计实现 run 总次数上限；达到预算 SPEC 置为 blocked 并发人工升级告警，人工调大后可解冻。"
                    }
                  ]
                },
                {
                  "title": "审批模式",
                  "body": [
                    {
                      "type": "radios",
                      "name": "gates.approve_mode",
                      "label": "审批模式",
                      "value": "manual",
                      "options": [
                        {
                          "label": "手动审批(manual)",
                          "value": "manual"
                        },
                        {
                          "label": "自动(auto)",
                          "value": "auto"
                        }
                      ]
                    }
                  ]
                },
                {
                  "title": "界面风格",
                  "body": [
                    {
                      "type": "radios",
                      "label": "界面主题",
                      "name": "__theme",
                      "value": "${theme}",
                      "mode": "inline",
                      "options": [
                        {
                          "label": "深色（默认）",
                          "value": "dark"
                        },
                        {
                          "label": "浅色",
                          "value": "light"
                        }
                      ],
                      "description": "切换后立即整页生效并持久化到浏览器（fenix.theme）。",
                      "onEvent": {
                        "change": {
                          "actions": [
                            {
                              "actionType": "custom",
                              "script": "localStorage.setItem('fenix.theme', event.data.value || 'dark'); window.location.reload();"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "tpl",
                      "tpl": "<div class='v2-muted'>主题偏好保存在浏览器 localStorage（fenix.theme），不进入保存路径。</div>"
                    }
                  ]
                }
              ]
            },
            {
              "type": "submit",
              "label": "保存配置"
            }
          ],
          "onEvent": {
            "submitSucc": {
              "actions": [
                {
                  "actionType": "toast",
                  "args": {
                    "msgType": "success",
                    "msg": "保存成功"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}