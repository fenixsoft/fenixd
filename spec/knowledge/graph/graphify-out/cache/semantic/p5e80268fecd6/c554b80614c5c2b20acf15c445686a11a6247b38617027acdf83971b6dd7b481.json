{"nodes": [{"id": "adr_adr_003_agent_lane_claude_config_dir_isolation", "label": "ADR-003: Agent lane LLM isolation must go through CLAUDE_CONFIG_DIR", "file_type": "document", "source_file": "adr/ADR-003-agent-lane-claude-config-dir-isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The env block in ~/.claude/settings.json overrides process environment variables, which would turn per-role provider assignment into dead code; CLAUDE_CONFIG_DIR replaces the whole config root and fully bypasses the user settings."}, {"id": "adr_adr_003_agent_lane_claude_config_dir_isolation_claude_config_dir", "label": "CLAUDE_CONFIG_DIR isolation directory", "file_type": "concept", "source_file": "adr/ADR-003-agent-lane-claude-config-dir-isolation.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The isolation directory stores mapping-style vars, enabledPlugins and hooks only; connection credentials travel via process env and never touch disk, while skills/plugins symlink back to ~/.claude so both isolation and capability are kept."}], "edges": [{"source": "adr_adr_003_agent_lane_claude_config_dir_isolation", "target": "adr_adr_002_model_routing_env_plus_official_model", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "adr/ADR-003-agent-lane-claude-config-dir-isolation.md", "source_location": null, "weight": 0.85}, {"source": "adr_adr_003_agent_lane_claude_config_dir_isolation", "target": "adr_adr_003_agent_lane_claude_config_dir_isolation_claude_config_dir", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "adr/ADR-003-agent-lane-claude-config-dir-isolation.md", "source_location": null, "weight": 1.0}, {"source": "adr_adr_003_agent_lane_claude_config_dir_isolation_claude_config_dir", "target": "adr_adr_002_model_routing_env_plus_official_model_env_route", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.8, "source_file": "adr/ADR-003-agent-lane-claude-config-dir-isolation.md", "source_location": null, "weight": 0.8}], "hyperedges": [{"id": "env_injected_provider_routing_path", "label": "Env/settings-injected provider routing and isolation path", "nodes": ["adr_adr_002_model_routing_env_plus_official_model_env_route", "adr_adr_002_model_routing_env_plus_official_model_sdk_model", "adr_adr_003_agent_lane_claude_config_dir_isolation_claude_config_dir"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "adr/ADR-003-agent-lane-claude-config-dir-isolation.md"}]}